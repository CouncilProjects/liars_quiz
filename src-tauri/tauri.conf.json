{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Liars party",
  "version": "0.1.0",
  "identifier": "amori.afterdark.liars",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Liar's party",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGMDQ5RThGNDgzMERBMzQKUldRMDJqQklqNTRFVDJ3OUZpeTl5TnY4SXN0ZUZpQjR6WTFTRHJkaERKay94ZjdiWEZ6VXJxcWcK",
      "endpoints": [
        "https://github.com/CouncilProjects/liars_quiz/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
